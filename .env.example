# ============================================================
# DataNest - Variables de entorno
# Copiar este archivo a .env.local y completar los valores
# NUNCA subir .env.local al repositorio
# ============================================================

# --- Base de datos (Neon PostgreSQL) ---
# Obtener en: https://neon.tech → tu proyecto → Connection string
DATABASE_URL=postgresql://datanest:datanest123@localhost:5433/datanest
# --- NextAuth.js ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-here"
# URL de tu app (cambiar en producción)
NEXTAUTH_URL="http://localhost:3002"

# --- Google OAuth ---
# Crear en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# --- OpenAI (para el chatbot GPT-4o-mini) ---
# Obtener en: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key"

# --- Mercado Pago OAuth ---
# Crear app en: https://www.mercadopago.com.ar/developers/panel
# Scopes necesarios: read, offline_access
MERCADOPAGO_CLIENT_ID="your-mercadopago-client-id"
MERCADOPAGO_CLIENT_SECRET="your-mercadopago-client-secret"
# URL de callback (debe coincidir con la configurada en el panel de MP)
MERCADOPAGO_REDIRECT_URI="http://localhost:3002/api/sources/mercadopago/callback"

# --- Configuración de la app ---
APP_URL="http://localhost:3002"
# Nombre de la app (aparece en emails y UI)
APP_NAME="DataNest"
